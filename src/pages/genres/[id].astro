---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PuzzleCard from '../../components/PuzzleCard.astro';
import { getGenres, getPuzzles, type Genre } from '../../lib/puzzles';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const genres = await getGenres();
  return genres.map((genre) => ({ params: { id: genre.id }, props: { genre } }));
}

const { genre } = Astro.props as { genre: Genre };
const { Content } = await render(genre);
const puzzles = (await getPuzzles()).filter((p) => p.data.genre.id === genre.id);
const preview = puzzles.slice(0, 12);
const d = genre.data;
---
<Base title={d.name.zh} description={d.summary}>
  <p class="muted"><a href={url('genres/')}>题型</a> / {d.category ?? '其他'}</p>
  <h1>{d.name.zh}</h1>
  <dl class="info">
    {d.name.ja && <><dt>日文</dt><dd>{d.name.ja}</dd></>}
    {d.name.en && <><dt>英文</dt><dd>{d.name.en}</dd></>}
    {d.aliases.length > 0 && <><dt>别名</dt><dd>{d.aliases.join('、')}</dd></>}
    {d.inventor && <><dt>发明/推广</dt><dd>{d.inventor}</dd></>}
  </dl>

  <article class="prose">
    <Content />
  </article>

  {d.example && (
    <section class="example">
      <h2>例题</h2>
      <div class="example-row">
        <figure>
          <Image src={d.example} alt={`${d.name.zh} 例题`} width={400} />
          <figcaption>例题</figcaption>
        </figure>
        {d.exampleAnswer && (
          <>
            <span class="arrow" aria-hidden="true">→</span>
            <figure>
              <Image src={d.exampleAnswer} alt={`${d.name.zh} 例题解答`} width={400} />
              <figcaption>解答</figcaption>
            </figure>
          </>
        )}
      </div>
    </section>
  )}

  {d.links.length > 0 && (
    <p class="links">
      {d.links.map((l) => <a class="button" href={l.url} target="_blank" rel="noopener">{l.label} ↗</a>)}
    </p>
  )}

  <h2>谜题（{puzzles.length}）</h2>
  {puzzles.length === 0 && <p class="muted">还没有收录这个题型的谜题。</p>}
  <div class="grid">
    {preview.map((p) => <PuzzleCard puzzle={p} />)}
  </div>
  {puzzles.length > preview.length && (
    <p><a class="button" href={url(`puzzles/?genre=${genre.id}`)}>查看全部 {puzzles.length} 道 →</a></p>
  )}
</Base>

<style>
  .info { display: grid; grid-template-columns: max-content 1fr; gap: 4px 16px; margin: 0 0 24px; }
  .info dt { color: var(--muted); }
  .info dd { margin: 0; }
  .prose { max-width: 760px; }
  .example-row { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .example figure { margin: 0; background: #fff; border: 1px solid var(--border); border-radius: var(--radius); padding: 12px; text-align: center; }
  .example figure :global(img) { display: block; width: 260px; max-width: 100%; height: auto; }
  .example figcaption { color: #656d76; font-size: .85rem; margin-top: 4px; }
  .arrow { font-size: 1.5rem; color: var(--muted); }
  .links { display: flex; gap: 8px; flex-wrap: wrap; }
</style>
